<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>BigCityLegacy</AssemblyName>
	<Authors>LegacyTeam</Authors>
	<VersionPrefix>1.3.1</VersionPrefix>
	<VersionSuffix>dev</VersionSuffix>
	<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RootNamespace>BigCityLegacy</RootNamespace>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	<GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\MadOut2_BigCityOnline</GameDir>
    <ManagedDir>$(GameDir)\game_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx\core</BepInExDir>
    <LegacyUIFrameworkDll Condition="'$(LegacyUIFrameworkDll)' == ''">$(OutputPath)\LegacyUIFramework.dll</LegacyUIFrameworkDll>
    <CopyToPlugins Condition="'$(CopyToPlugins)' == ''">false</CopyToPlugins> 
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;0618;0649</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;0618;0649</NoWarn>
  </PropertyGroup>

  <Target Name="GenerateVersionInfo" BeforeTargets="BeforeCompile;CoreCompile">
	<PropertyGroup>
		<_CleanVersion>$(VersionPrefix)</_CleanVersion>
		<_FullVersion Condition="'$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</_FullVersion>
		<_FullVersion Condition="'$(VersionSuffix)' == ''">$(VersionPrefix)</_FullVersion>
		<CurrentTimestamp>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss"))</CurrentTimestamp>
		
		<VersionCode>
			<![CDATA[
        public static class VersionInfo
        {
            public const string ModVersion = "$(_CleanVersion)"%3B
            public const string ModVersionName = "$(_FullVersion)"%3B
			public const string BuildTimestamp = "$(CurrentTimestamp) (UTC+0)"%3B
        }
        ]]>
		</VersionCode>
	</PropertyGroup>

	<WriteLinesToFile File="$(IntermediateOutputPath)VersionInfo.g.cs" Lines="$(VersionCode)" Overwrite="true" WriteOnlyWhenDifferent="true" />
	<ItemGroup>
		<Compile Include="$(IntermediateOutputPath)VersionInfo.g.cs" />
	</ItemGroup>
  </Target>

  <Target Name="ValidateGameDir" BeforeTargets="PrepareForBuild">
	 <Error Condition="'$(GameDir)' == '' Or !Exists('$(GameDir)')" Text="&#xD;&#xA;&gt; &gt; &gt; &gt; &gt; &gt; Invalid GameDir: '$(GameDir)' &lt; &lt; &lt; &lt; &lt; &lt; &#xD;&#xA;&#xD;&#xA;The project requires access to the game's Unity assemblies.&#xD;&#xA;Set &lt;GameDir&gt; in the .csproj file or specify it on the command line:&#xD;&#xA;dotnet build -p:GameDir=&quot;path\to\game&quot;&#xD;&#xA;&#xD;&#xA;IN CLI USE ONLY ABSOLUTE PATHS (without '..\' or etc.)" />
  </Target>

